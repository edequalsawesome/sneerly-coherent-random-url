{
  "name": "sneerly-coherent-random-post",
  "version": "2026.08.001",
  "description": "WordPress plugin for random post functionality with Gutenberg block",
  "main": "build/index.js",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:style": "wp-scripts lint-style",
    "zip": "npm run i18n:json && wp-scripts plugin-zip",
    "i18n:pot": "wp i18n make-pot . languages/sneerly-coherent-random.pot --domain=sneerly-coherent-random --exclude=node_modules,build,tests --headers=\"{\\\"Report-Msgid-Bugs-To\\\":\\\"https://github.com/edequalsawesome/sneerly-coherent-random-url/issues\\\"}\"",
    "i18n:json": "wp i18n make-json languages --no-purge --use-map=\"{\\\"src/index.js\\\":\\\"build/index.js\\\"}\"",
    "plugin-zip": "npm run zip --"
  },
  "files": [
    "build",
    "languages",
    "src",
    "sneerly-coherent-random-url.php",
    "README.txt"
  ],
  "author": "eD! Thomas",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@wordpress/scripts": "^30.7.0"
  },
  "dependencies": {
    "@wordpress/icons": "^10.9.0"
  }
}
